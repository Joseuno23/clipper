POSTGRES_DB=clipper_dev
POSTGRES_USER=clipper
POSTGRES_PASSWORD=clipper_dev_password
POSTGRES_PORT=5432

DATABASE_URL="postgresql://clipper:clipper_dev_password@localhost:5432/clipper_dev?schema=public"

SEED_ADMIN_EMAIL="admin@niche72.local"
SEED_ADMIN_PASSWORD="change-me-min-12-chars"
SEED_ADMIN_NAME="Niche 72 Admin"
SEED_SHOP_NAME="Niche 72"
SEED_SHOP_SLUG="niche-72"
SEED_SHOP_TIMEZONE="America/Bogota"
SEED_SHOP_CURRENCY="COP"
SEED_APPOINTMENT_CHANGE_LIMIT_SECONDS=86400

# JWT auth defaults: issuer=clipper, audience=clipper-web, access token TTL=2h.
# Use a unique 32+ character secret per environment; never reuse this example value.
JWT_SECRET="replace-with-at-least-32-characters"
JWT_ISSUER="clipper"
JWT_AUDIENCE="clipper-web"
JWT_ACCESS_TOKEN_TTL="2h"

# Production split deployment:
# - Vercel frontend: set VITE_API_BASE_URL to the Railway API origin.
# - Railway API: set CORS_ORIGIN to the Vercel frontend origin.
# Leave VITE_API_BASE_URL empty locally to keep vite dev serving /api/* itself.
VITE_API_BASE_URL=""
CORS_ORIGIN="http://localhost:5173"
