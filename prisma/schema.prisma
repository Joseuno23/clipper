generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Domain-service-only invariants intentionally deferred because Prisma cannot
// express them portably here: positive prices/durations/quantities, appointment
// overlap prevention, exact sale payment totals, stock sufficiency, working-day
// enforcement, audit emission, and soft-delete-aware partial unique reuse. Queue
// one-in-service, active-position, and active-client uniqueness are enforced by
// SQL partial unique indexes in migrations plus repository transaction guards.

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum BarberShopMemberRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum StaffRole {
  BARBER
  STYLIST
  COLORIST
  ASSISTANT
  MANAGER
}

enum CommissionMode {
  NONE
  PERCENTAGE_BPS
  FIXED_AMOUNT
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  LOSS
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WALK_IN
  PHONE
  ONLINE
  STAFF
}

enum QueueStatus {
  NOT_QUEUED
  WAITING
  CALLED
  IN_SERVICE
  SERVED
  LEFT
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum SaleItemKind {
  SERVICE
  PRODUCT
  CUSTOM
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CANCEL
  COMPLETE
  ADJUST
}

model BarberShop {
  id                            String    @id @default(cuid())
  name                          String
  slug                          String    @unique
  timezone                      String
  currency                      String    @default("ARS")
  appointmentChangeLimitSeconds Int       @default(86400)
  isActive                      Boolean   @default(true)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  deletedAt                     DateTime?

  members            BarberShopMember[]
  clients            Client[]
  staffMembers       StaffMember[]
  services           Service[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  appointments       Appointment[]
  sales              Sale[]
  auditLogs          AuditLog[]

  @@index([isActive])
  @@index([deletedAt])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  memberships BarberShopMember[]
  staffLinks  StaffMember[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([deletedAt])
}

model BarberShopMember {
  id           String               @id @default(cuid())
  barberShopId String
  userId       String
  role         BarberShopMemberRole @default(STAFF)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  barberShop BarberShop @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([barberShopId, userId])
  @@index([barberShopId, role])
  @@index([userId])
}

model Client {
  id                 String    @id @default(cuid())
  barberShopId       String
  firstName          String
  lastName           String
  email              String?
  normalizedEmail    String?
  phone              String?
  normalizedPhone    String?
  documentNumber     String?
  normalizedDocument String?
  notes              String?
  isBlocked          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  barberShop   BarberShop    @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  sales        Sale[]

  @@unique([barberShopId, normalizedEmail])
  @@unique([barberShopId, normalizedPhone])
  @@unique([barberShopId, normalizedDocument])
  @@index([barberShopId, isBlocked])
  @@index([barberShopId, deletedAt])
  @@index([barberShopId, lastName, firstName])
}

model StaffMember {
  id              String         @id @default(cuid())
  barberShopId    String
  userId          String?
  firstName       String
  lastName        String
  displayName     String
  email           String?
  normalizedEmail String?
  phone           String?
  normalizedPhone String?
  photoDataUrl    String?
  isActive        Boolean        @default(true)
  commissionMode  CommissionMode @default(NONE)
  commissionValue Decimal        @default(0) @db.Decimal(12, 2)
  workingDays     Int[]
  restDays        DateTime[]
  specialties     String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  barberShop         BarberShop               @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  user               User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  roles              StaffMemberRole[]
  services           ServiceAllowedRole[]
  serviceCommissions StaffServiceCommission[]
  appointments       Appointment[]
  sales              Sale[]

  @@unique([barberShopId, userId])
  @@unique([barberShopId, normalizedEmail])
  @@unique([barberShopId, normalizedPhone])
  @@index([barberShopId, isActive])
  @@index([barberShopId, deletedAt])
  @@index([userId])
}

model StaffMemberRole {
  id            String    @id @default(cuid())
  staffMemberId String
  barberShopId  String
  role          StaffRole
  createdAt     DateTime  @default(now())

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, role])
  @@index([barberShopId, role])
}

model Service {
  id              String    @id @default(cuid())
  barberShopId    String
  name            String
  description     String?
  durationMinutes Int
  price           Decimal   @db.Decimal(12, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  barberShop          BarberShop               @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  allowedRoles        ServiceAllowedRole[]
  staffCommissions    StaffServiceCommission[]
  appointmentServices AppointmentService[]
  saleItems           SaleItem[]

  @@unique([barberShopId, name])
  @@index([barberShopId, isActive])
  @@index([barberShopId, deletedAt])
}

model ServiceAllowedRole {
  id            String    @id @default(cuid())
  serviceId     String
  barberShopId  String
  role          StaffRole
  staffMemberId String?
  createdAt     DateTime  @default(now())

  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffMember StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([serviceId, role])
  @@index([barberShopId, role])
  @@index([staffMemberId])
}

model StaffServiceCommission {
  id              String         @id @default(cuid())
  staffMemberId   String
  serviceId       String
  barberShopId    String
  commissionMode  CommissionMode @default(NONE)
  commissionValue Decimal        @default(0) @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, serviceId])
  @@index([barberShopId, serviceId])
  @@index([serviceId])
}

model Product {
  id           String    @id @default(cuid())
  barberShopId String
  name         String
  sku          String?
  barcode      String?
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  cost         Decimal?  @db.Decimal(12, 2)
  currentStock Int       @default(0)
  lowStockAt   Int?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  barberShop         BarberShop          @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@unique([barberShopId, name])
  @@unique([barberShopId, sku])
  @@unique([barberShopId, barcode])
  @@index([barberShopId, isActive])
  @@index([barberShopId, deletedAt])
}

model InventoryMovement {
  id           String                @id @default(cuid())
  barberShopId String
  productId    String
  saleItemId   String?
  type         InventoryMovementType
  quantity     Int
  reason       String?
  note         String?
  occurredAt   DateTime              @default(now())
  createdAt    DateTime              @default(now())

  barberShop BarberShop @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleItem   SaleItem?  @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  @@index([barberShopId, occurredAt])
  @@index([barberShopId, type])
  @@index([productId, occurredAt])
  @@index([saleItemId])
}

model Appointment {
  id                 String            @id @default(cuid())
  barberShopId       String
  clientId           String?
  staffMemberId      String?
  status             AppointmentStatus @default(SCHEDULED)
  source             AppointmentSource @default(STAFF)
  startAt            DateTime
  endAt              DateTime
  checkedInAt        DateTime?
  queuedAt           DateTime?
  queuePosition      Int?
  queueStatus        QueueStatus       @default(NOT_QUEUED)
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  barberShop  BarberShop           @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  client      Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  staffMember StaffMember?         @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  services    AppointmentService[]
  sales       Sale[]

  @@index([barberShopId, status])
  @@index([barberShopId, startAt])
  @@index([barberShopId, status, startAt])
  @@index([barberShopId, queueStatus, queuedAt])
  @@index([clientId])
  @@index([staffMemberId, startAt])
}

model AppointmentService {
  id                      String   @id @default(cuid())
  appointmentId           String
  serviceId               String?
  barberShopId            String
  serviceNameSnapshot     String
  servicePriceSnapshot    Decimal  @db.Decimal(12, 2)
  serviceDurationSnapshot Int
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([barberShopId, appointmentId])
  @@index([serviceId])
}

model Sale {
  id            String     @id @default(cuid())
  barberShopId  String
  appointmentId String?
  clientId      String?
  staffMemberId String?
  saleNumber    String
  status        SaleStatus @default(DRAFT)
  subtotal      Decimal    @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  businessDate  DateTime
  completedAt   DateTime?
  cancellationReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  barberShop  BarberShop    @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  staffMember StaffMember?  @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    SalePayment[]

  @@unique([barberShopId, saleNumber])
  @@index([barberShopId, status])
  @@index([barberShopId, businessDate])
  @@index([barberShopId, createdAt])
  @@index([appointmentId])
  @@index([clientId])
}

model SaleItem {
  id             String       @id @default(cuid())
  saleId         String
  barberShopId   String
  kind           SaleItemKind
  serviceId      String?
  productId      String?
  description    String
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  commissionModeSnapshot  CommissionMode?
  commissionValueSnapshot Decimal?        @db.Decimal(12, 2)
  commissionTotalSnapshot Decimal?        @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  sale               Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service            Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@index([barberShopId, kind])
  @@index([saleId])
  @@index([serviceId])
  @@index([productId])
}

model SalePayment {
  id           String        @id @default(cuid())
  saleId       String
  barberShopId String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  reference    String?
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([barberShopId, method])
  @@index([barberShopId, paidAt])
  @@index([saleId])
}

model AuditLog {
  id           String      @id @default(cuid())
  barberShopId String
  actorUserId  String?
  action       AuditAction
  entityType   String
  entityId     String?
  message      String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  barberShop BarberShop @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  actorUser  User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([barberShopId, createdAt])
  @@index([barberShopId, entityType, entityId])
  @@index([actorUserId])
}
